# Copy this to .env and fill in your values

# Required for all 3 demos — Groq API (free, no credit card needed)
# Sign up and get your key at: https://console.groq.com
# Free tier: generous daily limits, ~500 tokens/sec, no billing required
GROQ_API_KEY=gsk_...

# Optional but strongly recommended for Demo 3
# Without this, GitHub API is rate-limited to 60 req/hour
# Get one at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=ghp_...

# NOT NEEDED — both OpenAI and HuggingFace API keys are no longer used:
#   Embeddings → sentence-transformers (runs 100% locally, no key needed)
#   Chat/Agent → Groq API (key above)
